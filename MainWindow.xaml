<Window x:Class="BudgetSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BudgetSuite.Converters"
        Title="Budget Defender &amp; Planner Suite" Height="740" Width="1140"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#121218" FontFamily="Malgun Gothic, Segoe UI"
        Icon="app.ico"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshFromCloudCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConv" />

        <!-- 반투명 다크 아크릴 글래스 카드 스타일 (배경 일러스트가 은은히 비침) -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#CC1E1E2E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 텍스트박스 공통 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#E6313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="border" Property="Background" Value="#3B3D52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 사이드바 탭 버튼 기본 템플릿 -->
        <Style x:Key="BaseSidebarBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" 
                                Padding="12,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3389B4FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 사이드바 탭 0 버튼 스타일 (일일 예산 방어) -->
        <Style x:Key="SidebarBtn0" BasedOn="{StaticResource BaseSidebarBtn}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Background" Value="#E6313244"/>
                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                    <Setter Property="Foreground" Value="#89B4FA"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 사이드바 탭 1 버튼 스타일 (수당 및 고정지출) -->
        <Style x:Key="SidebarBtn1" BasedOn="{StaticResource BaseSidebarBtn}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Background" Value="#E6313244"/>
                    <Setter Property="BorderBrush" Value="#F9E2AF"/>
                    <Setter Property="Foreground" Value="#F9E2AF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 사이드바 탭 2 버튼 스타일 (월간 분석) -->
        <Style x:Key="SidebarBtn2" BasedOn="{StaticResource BaseSidebarBtn}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="Background" Value="#E6313244"/>
                    <Setter Property="BorderBrush" Value="#A6E3A1"/>
                    <Setter Property="Foreground" Value="#A6E3A1"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 일반 버튼 스타일 -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 체크박스 스타일 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 데이터그리드 헤더 & 로우 스타일 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E6181825"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 콤보박스 아이템 다크 스타일 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3B3D52"/>
                                <Setter Property="Foreground" Value="#A6E3A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 모던 다크 콤보박스 스타일 -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#E6313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0,26,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <!-- 드롭다운 열기/닫기 토글 버튼 -->
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <DockPanel LastChildFill="False">
                                                <Path x:Name="arrow"
                                                      DockPanel.Dock="Right"
                                                      Margin="0,0,10,0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#89B4FA"
                                                      VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                                                <Setter TargetName="border" Property="Background" Value="#3B3D52"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#89B4FA"/>
                                                <Setter TargetName="border" Property="Background" Value="#3B3D52"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 선택된 항목 텍스트 표시 -->
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="SemiBold"/>

                            <!-- 드롭다운 팝업 -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="dropDownBorder"
                                        Background="#1E1E2E"
                                        BorderBrush="#89B4FA"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2" SnapsToDevicePixels="True" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGridRow 스타일: 마우스 호버 및 행 선택 시 선명한 하이라이트 -->
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#25253A"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4D89B4FA"/>
                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2689B4FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- [1] 배경 이미지 레이어 (Miku_Jirai.jpg 확실히 로드 및 Opacity 상향 조정) -->
        <Image Source="pack://application:,,,/Miku_Jirai.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Opacity="0.5"/>

        <!-- [2] 다크 그라데이션 오버레이 (상단은 투명하여 일러스트가 드러나고 하단만 부드럽게 감싸 가독성 유지) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0A121218" Offset="0"/>
                    <GradientStop Color="#55121218" Offset="0.45"/>
                    <GradientStop Color="#A6121218" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- [3] 메인 레이아웃: 좌측 세로 사이드바 + 우측 대시보드 콘텐츠 -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 좌측 사이드바 패널 ================= -->
            <Border Grid.Column="0" Background="#D9181825" CornerRadius="12" Padding="14,16" 
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 사이드바 헤더 (아이콘 + 프로그램명) -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.6" Color="#89B4FA"/>
                                </Image.Effect>
                            </Image>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BudgetSuite" FontSize="17" FontWeight="ExtraBold" Foreground="#CDD6F4"/>
                                <TextBlock Text="Defender &amp; Planner" FontSize="10.5" Foreground="#9399B2"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Separator Grid.Row="1" Background="#2BFFFFFF" Margin="0,0,0,14"/>

                    <!-- 사이드바 탭 메뉴 목록 -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="메뉴" FontSize="11" FontWeight="Bold" Foreground="#6C7086" Margin="6,0,0,8"/>

                        <!-- 탭 0: 일일 예산 방어 -->
                        <Button Style="{StaticResource SidebarBtn0}" Command="{Binding SelectTabCommand}" CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="일일 예산 방어" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- 탭 1: 수당 & 고정지출 플래너 -->
                        <Button Style="{StaticResource SidebarBtn1}" Command="{Binding SelectTabCommand}" CommandParameter="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="수당 &amp; 고정지출" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- 탭 2: 월간 분석 & 기록 -->
                        <Button Style="{StaticResource SidebarBtn2}" Command="{Binding SelectTabCommand}" CommandParameter="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="월간 지출·수입 분석" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 사이드바 하단 정보 카드 -->
                    <StackPanel Grid.Row="3">
                        <!-- 클라우드 실시간 동기화 상태 및 새로고침 버튼 카드 -->
                        <Border Background="#24273A" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#3B3D52" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse Width="7" Height="7" Fill="#A6E3A1" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="클라우드 동기화" FontSize="10.5" Foreground="#A6ADC8" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CloudSyncStatusText}" FontSize="11" Foreground="#89B4FA" FontWeight="Bold"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RefreshFromCloudCommand}" 
                                        ToolTip="지금 클라우드 최신 데이터 동기화 (단축키: F5)"
                                        Background="#3389B4FA" BorderBrush="#89B4FA" BorderThickness="1"
                                        Cursor="Hand" Padding="7,4" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="🔄 F5" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#5589B4FA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Background="#24273A" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderBrush="#3B3D52" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💳 실시간 통장 잔고" FontSize="10.5" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding CurrentBank, StringFormat='{}{0:N0} 원'}" FontSize="13.5" Foreground="#A6E3A1" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#24273A" CornerRadius="8" Padding="12,8" Margin="0" BorderBrush="#3B3D52" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📅 당월 현황" FontSize="10.5" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DateInfoText}" FontSize="11.5" Foreground="#89DCEB" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 우측 메인 콘텐츠 패널 ================= -->
            <Grid Grid.Column="2">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ================= 탭 0: 일일 예산 방어기 ================= -->
                    <TabItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측: 잔고/기준치 설정 & 최종 결과 배너 -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,4,0">
                                    <!-- 통장 및 기준치 설정 카드 -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <TextBlock Text="💳 통장 잔고 &amp; 방어선 설정" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>

                                            <DockPanel Margin="0,2,0,2"><TextBlock Text="현재 통장 잔고 (원)" Foreground="#BAC2DE" FontSize="12"/><Border Background="#33A6E3A1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" ToolTip="현금/체크 지출 등록 및 고정지출 완료 체크 시 자동으로 차감됩니다. 실제 은행 잔고와 다르면 직접 수정하세요."><TextBlock Text="● 실시간 자동 차감" Foreground="#A6E3A1" FontSize="10" FontWeight="Bold"/></Border><TextBlock Text="{Binding StartOfDayBank, StringFormat='오늘 시작: {0:N0}원'}" Foreground="#6C7086" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                                            <TextBox Text="{Binding CurrentBank, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}"/>

                                            <!-- 월말 목표 잔고 (안전 방어선) -->
                                            <StackPanel Margin="0,8,0,0">
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock Text="월말 목표 잔고" Foreground="#BAC2DE" FontSize="12"/>
                                                    <Border Background="#3389B4FA" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" ToolTip="월말 통장에 반드시 남겨둘 비상 방어선입니다. 설정하신 금액으로 안전하게 유지됩니다.">
                                                        <TextBlock Text="{Binding TargetBalance, StringFormat='● {0:N0}원 방어선 유지'}" Foreground="#89B4FA" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBox Text="{Binding TargetBalance, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>

                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock Text="오늘 총 현금 지출:" Foreground="#BAC2DE" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SpentTodayCash, StringFormat='{}{0:N0} 원'}" Foreground="#FAB387" 
                                                           FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 포인트 방패 카드 -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="✨ 가용 포인트/머니 방패" FontSize="13" FontWeight="Bold" Foreground="#89DCEB"/>
                                                <TextBlock Text="{Binding TotalShieldPoints, StringFormat='총합: {0:N0} P/원'}" 
                                                           FontSize="12" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="네이버페이 포인트" Foreground="#BAC2DE" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding NaverPoints, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock Text="카카오페이머니" Foreground="#BAC2DE" FontSize="11"/>
                                                        <Button Content="동기화" Command="{Binding SyncKakaoMoneyCommand}" 
                                                                Background="#313244" Foreground="#F9E2AF" FontSize="10" Padding="4,1" 
                                                                HorizontalAlignment="Right" ToolTip="플래너의 카카오페이 용돈을 반영"/>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding KakaoPayMoney, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 최종 실질 가용 현금 결과 카드 -->
                                    <Border Background="#E6181825" CornerRadius="10" Padding="14" BorderBrush="#A6E3A1" BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="오늘 남은 실질 가용 현금 (1,000원 단위 절사)" FontSize="12" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DailyAvailableRounded, StringFormat='{}{0:N0} 원'}" FontSize="28" FontWeight="ExtraBold" 
                                                       Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DailyStatusMessage}" FontSize="11" Foreground="#A6ADC8" 
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 우측: 오늘 지출 입력 및 당일 내역 리스트 (시원하게 확장된 공간) -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 거래 입력 폼 (지출, 수입 및 이체 모드 지원) -->
                                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- 상단: 폼 타이틀 & [지출 등록] / [수입 등록] / [이체/분배] 모드 전환 세그먼트 -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding FormTitleText}" FontSize="14" FontWeight="Bold" Foreground="#F5C2E7" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="지출 등록" Command="{Binding SetTransactionModeCommand}" CommandParameter="지출"
                                                        Padding="10,4" FontSize="11.5" FontWeight="Bold" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#313244"/>
                                                            <Setter Property="Foreground" Value="#BAC2DE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpenseMode}" Value="True">
                                                                    <Setter Property="Background" Value="#F38BA8"/>
                                                                    <Setter Property="Foreground" Value="#11111B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="수입 등록" Command="{Binding SetTransactionModeCommand}" CommandParameter="수입"
                                                        Padding="10,4" FontSize="11.5" FontWeight="Bold" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#313244"/>
                                                            <Setter Property="Foreground" Value="#BAC2DE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIncomeMode}" Value="True">
                                                                    <Setter Property="Background" Value="#A6E3A1"/>
                                                                    <Setter Property="Foreground" Value="#11111B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="이체/분배" Command="{Binding SetTransactionModeCommand}" CommandParameter="이체"
                                                        Padding="10,4" FontSize="11.5" FontWeight="Bold" ToolTip="일일 한도를 깎지 않고 카카오페이머니·키움증권계좌로 자금을 쪼개서 이동합니다.">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#313244"/>
                                                            <Setter Property="Foreground" Value="#BAC2DE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTransferMode}" Value="True">
                                                                    <Setter Property="Background" Value="#CBA6F7"/>
                                                                    <Setter Property="Foreground" Value="#11111B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 1행: 항목명 (100% 전체 너비) -->
                                        <TextBlock Text="{Binding DescLabelText}" Foreground="#BAC2DE" FontSize="11.5" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <TextBox x:Name="TxtNewDescInput" Text="{Binding NewDesc, UpdateSourceTrigger=PropertyChanged}" 
                                                     HorizontalContentAlignment="Left" Height="34" FontSize="13.5"/>
                                            <TextBlock Text="{Binding DescPlaceholderText}" Foreground="#6C7086" FontSize="12.5" 
                                                       VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtNewDescInput}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- 2행: 금액 + 결제/입금 수단 + 추가 버튼 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="235"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="금액 (원)" Foreground="#BAC2DE" FontSize="11.5" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MethodLabelText}" Foreground="#BAC2DE" FontSize="11.5" FontWeight="SemiBold" Margin="2,0,0,4"/>

                                            <!-- 금액 입력창 -->
                                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewAmount, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}" 
                                                     Height="34" FontSize="13.5" Margin="0,0,8,0"/>

                                            <!-- 결제 수단 / 입금 수단 세그먼트 버튼 (지출/수입 모드용) -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="#24273A" CornerRadius="6" Padding="2" Height="34" Margin="0,0,8,0" BorderBrush="#3B3D52" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTransferMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <UniformGrid Columns="3">
                                                    <Button Content="현금/체크" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="현금/체크"
                                                            FontSize="11" FontWeight="Bold" Margin="1" Cursor="Hand" ToolTip="현금 및 체크카드">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#BAC2DE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#89B4FA"/>
                                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="네이버P" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="네이버페이 포인트"
                                                            FontSize="11" FontWeight="Bold" Margin="1" Cursor="Hand" ToolTip="네이버페이 포인트">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#BAC2DE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNaverSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#A6E3A1"/>
                                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="카카오P" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="카카오페이머니"
                                                            FontSize="11" FontWeight="Bold" Margin="1" Cursor="Hand" ToolTip="카카오페이머니">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#BAC2DE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsKakaoSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#F9E2AF"/>
                                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </UniformGrid>
                                            </Border>

                                            <!-- 이체 대상 계좌 세그먼트 버튼 (이체/분배 모드용) -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="#24273A" CornerRadius="6" Padding="2" Height="34" Margin="0,0,8,0" BorderBrush="#3B3D52" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTransferMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <UniformGrid Columns="2">
                                                    <Button Content="카카오페이머니" Command="{Binding SelectTransferTargetCommand}" CommandParameter="카카오페이머니"
                                                            FontSize="11" FontWeight="Bold" Margin="1" Cursor="Hand" ToolTip="통장에서 빼서 카카오페이머니 잔액에 자동 추가합니다.">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#BAC2DE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTransferKakaoSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#F9E2AF"/>
                                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="키움증권계좌" Command="{Binding SelectTransferTargetCommand}" CommandParameter="키움증권계좌"
                                                            FontSize="11" FontWeight="Bold" Margin="1" Cursor="Hand" ToolTip="통장에서 키움증권 투자 계좌로 자금을 이동합니다.">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="#BAC2DE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTransferKiwoomSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#CBA6F7"/>
                                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </UniformGrid>
                                            </Border>

                                            <!-- 추가 버튼 (모드에 따라 색상/문구 동적 반영) -->
                                            <Button Grid.Row="1" Grid.Column="2" Content="{Binding AddButtonText}" Command="{Binding AddTransactionCommand}" 
                                                    FontSize="13" Height="34">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#89B4FA"/>
                                                        <Setter Property="Foreground" Value="#11111B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncomeMode}" Value="True">
                                                                <Setter Property="Background" Value="#A6E3A1"/>
                                                                <Setter Property="Foreground" Value="#11111B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTransferMode}" Value="True">
                                                                <Setter Property="Background" Value="#CBA6F7"/>
                                                                <Setter Property="Foreground" Value="#11111B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 오늘 거래 내역 DataGrid (구분 컬럼 포함) -->
                                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="4" Margin="0,0,0,8">
                                    <DataGrid x:Name="DgTodayExpenses" ItemsSource="{Binding TodayExpenses}"
                                              SelectedItem="{Binding SelectedTodayExpense, Mode=TwoWay}"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              Background="Transparent" Foreground="#CDD6F4" RowBackground="#B31E1E2E" AlternatingRowBackground="#B324273A"
                                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#313244">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="55"/>
                                            <DataGridTextColumn Header="구분" Binding="{Binding ItemType}" Width="55">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#FAB387"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                                                <Setter Property="Foreground" Value="#CBA6F7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="항목명" Binding="{Binding Description}" Width="*"/>
                                            <DataGridTextColumn Header="수단/계좌" Binding="{Binding PaymentMethod}" Width="110"/>
                                            <DataGridTextColumn Header="금액(원)" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="95">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                                                <Setter Property="Foreground" Value="#CBA6F7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- 하단 바: 삭제 버튼 & 오늘 총액 -->
                                <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 좌측: 선택 항목 삭제 버튼 (왼쪽 정렬 고정) -->
                                    <Button Grid.Column="0" Content="선택 항목 삭제" Command="{Binding DeleteTodayExpenseCommand}" 
                                            CommandParameter="{Binding ElementName=DgTodayExpenses, Path=SelectedItem}"
                                            Background="#F38BA8" Foreground="#11111B" Padding="14,6" FontSize="12"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                    <!-- 우측: 오늘 현금/포인트 실시간 집계 요약 -->
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                                            <TextBlock Text="오늘 현금:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SpentTodayCash, StringFormat='-{0:N0}원'}" Foreground="#FAB387" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding IncomeTodayCash, StringFormat='+{0:N0}원'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2">
                                            <TextBlock Text="포인트/머니:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SpentTodayPoints, StringFormat='-{0:N0}원'}" Foreground="#89DCEB" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding IncomeTodayPoints, StringFormat='+{0:N0}원'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <TextBlock Text="이체:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding TransferTodayTotal, StringFormat='{}{0:N0}원'}" Foreground="#CBA6F7" FontWeight="Bold" FontSize="11.5"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ================= 탭 1: 월간 수당 & 고정지출 플래너 ================= -->
                    <TabItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측: 수당/투자 계획 + 실시간 요약 -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,4,0">
                                    <!-- 1. 수당 & 수입 계획 카드 (동적 추가/삭제 가능) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💰 수당 &amp; 수입 계획" FontSize="14" FontWeight="Bold" Foreground="#F9E2AF"/>
                                                    <TextBlock Text="{Binding TotalIncome, StringFormat='(총 {0:N0}원)'}" FontSize="12" Foreground="#BAC2DE" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Content="+ 항목 추가" Command="{Binding AddIncomePlanCommand}" 
                                                        Background="#89B4FA" Foreground="#11111B" Padding="10,4" HorizontalAlignment="Right" FontSize="11.5"/>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding IncomePlans}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" 
                                                                     HorizontalContentAlignment="Left" Margin="0,0,6,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}" 
                                                                     Margin="0,0,6,0"/>
                                                            <Button Grid.Column="2" Content="✕" 
                                                                    Command="{Binding DataContext.DeleteIncomePlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#F38BA8" FontSize="13" FontWeight="Bold"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. 투자 & 저축/용돈 계획 카드 (동적 추가/삭제 가능) -->
                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📈 투자 &amp; 용돈 계획" FontSize="14" FontWeight="Bold" Foreground="#89DCEB"/>
                                                    <TextBlock Text="{Binding TotalInvestment, StringFormat='(총 {0:N0}원)'}" FontSize="12" Foreground="#BAC2DE" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Content="+ 항목 추가" Command="{Binding AddInvestmentPlanCommand}" 
                                                        Background="#89B4FA" Foreground="#11111B" Padding="10,4" HorizontalAlignment="Right" FontSize="11.5"/>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding InvestmentPlans}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" 
                                                                     HorizontalContentAlignment="Left" Margin="0,0,6,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}" 
                                                                     Margin="0,0,6,0"/>
                                                            <Button Grid.Column="2" Content="✕" 
                                                                    Command="{Binding DataContext.DeleteInvestmentPlanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#F38BA8" FontSize="13" FontWeight="Bold"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. 실시간 계산 요약 카드 -->
                                    <Border Style="{StaticResource GlassCard}" Background="#E6181825">
                                        <StackPanel>
                                            <TextBlock Text="📊 실시간 월간 요약" FontSize="14" FontWeight="Bold" Foreground="#89DCEB" Margin="0,0,0,10"/>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="총 수당 입금액:" Foreground="#A6ADC8" FontSize="12"/>
                                                <TextBlock Text="{Binding TotalIncome, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="총 투자금 합계:" Foreground="#A6ADC8" FontSize="12"/>
                                                <TextBlock Text="{Binding TotalInvestment, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#F9E2AF" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="투자 차감 후 잔액:" Foreground="#A6ADC8" FontSize="12"/>
                                                <TextBlock Text="{Binding AccountBalance, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="이번 달 총 고정지출:" Foreground="#A6ADC8" FontSize="12"/>
                                                <TextBlock Text="{Binding TotalFixedExpenses, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#F38BA8" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="남은 고정지출 (미출금):" Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RemainingFixedExpenses, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#FAB387" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="납부 완료 고정지출:" Foreground="#BAC2DE" FontSize="12"/>
                                                <TextBlock Text="{Binding PaidFixedExpenses, StringFormat='{}{0:N0} 원'}" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <Separator Background="#313244" Margin="0,8"/>

                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="현재 실시간 통장 잔고:" Foreground="#A6E3A1" FontSize="12.5" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CurrentBank, StringFormat='{}{0:N0} 원'}" FontWeight="ExtraBold" FontSize="14.5" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 우측: 고정지출 목록 관리 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="📑 월간 고정지출 체크리스트" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4"/>
                                        <TextBlock Text="매월 1일 완료 체크가 자동으로 안전하게 해제됩니다." FontSize="11" Foreground="#9399B2"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🔄 체크 초기화" Command="{Binding ResetFixedExpensesCommand}" 
                                                Background="#313244" Foreground="#FAB387" Padding="10,5" Margin="0,0,8,0" FontSize="12"
                                                Cursor="Hand" ToolTip="이번 달 고정지출을 모두 미납(체크 해제) 상태로 초기화합니다."/>
                                        <Button Content="+ 항목 추가" Command="{Binding AddFixedExpenseCommand}" 
                                                Background="#89B4FA" Foreground="#11111B" Padding="12,5" FontSize="12" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 고정지출 리스트 -->
                                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FixedExpenses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                                 HorizontalContentAlignment="Left" Margin="0,0,6,0"/>

                                                        <TextBox Grid.Column="1" Text="{Binding Amount, Converter={StaticResource CurrencyConv}, UpdateSourceTrigger=LostFocus}" 
                                                                 Margin="0,0,6,0"/>

                                                        <CheckBox Grid.Column="2" Content="완료" IsChecked="{Binding IsPaid}" 
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <Button Grid.Column="3" Content="✕" 
                                                                Command="{Binding DataContext.DeleteFixedExpenseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" Foreground="#F38BA8" FontSize="13" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ================= 탭 2: 월간 지출·수입 통계 및 분석 ================= -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 상단 월간 통계 요약 카드 6개 그리드 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. 이번 달 총 수입 -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="이번 달 총 수입" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthTotalIncome, StringFormat='{}{0:N0}원'}" FontSize="15" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 이번 달 총 지출 -->
                                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="이번 달 총 지출" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthTotalSpent, StringFormat='{}{0:N0}원'}" FontSize="15" FontWeight="Bold" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. 현금/체크 지출 -->
                                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="현금/체크 지출" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthCashSpent, StringFormat='{}{0:N0}원'}" FontSize="15" FontWeight="Bold" Foreground="#FAB387" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. 포인트 방어액 -->
                                <Border Grid.Column="6" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="포인트 방어액" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthPointSpent, StringFormat='{}{0:N0}원'}" FontSize="15" FontWeight="Bold" Foreground="#89DCEB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 5. 기록 일수 -->
                                <Border Grid.Column="8" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="기록 일수" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthRecordedDays, StringFormat='{}{0}일'}" FontSize="15" FontWeight="Bold" Foreground="#CDD6F4" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 6. 일평균 현금 지출 -->
                                <Border Grid.Column="10" Style="{StaticResource GlassCard}" Margin="0" Padding="10,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="일평균 현금 지출" FontSize="11" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MonthDailyAvgCash, StringFormat='{}{0:N0}원'}" FontSize="15" FontWeight="Bold" Foreground="#F9E2AF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 월간 전체 지출/수입 히스토리 DataGrid -->
                            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="4" Margin="0,0,0,8">
                                <DataGrid x:Name="DgHistoryExpenses" ItemsSource="{Binding MonthlyHistoryExpenses}" 
                                          SelectedItem="{Binding SelectedHistoryExpense, Mode=TwoWay}"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          Background="Transparent" Foreground="#CDD6F4" RowBackground="#B31E1E2E" AlternatingRowBackground="#B324273A"
                                          BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#313244">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="95"/>
                                        <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="60"/>
                                        <DataGridTextColumn Header="구분" Binding="{Binding ItemType}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#FAB387"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                                            <Setter Property="Foreground" Value="#CBA6F7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="항목명" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTextColumn Header="수단/계좌" Binding="{Binding PaymentMethod}" Width="110"/>
                                        <DataGridTextColumn Header="금액(원)" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                            <Setter Property="Foreground" Value="#A6E3A1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTransfer}" Value="True">
                                                            <Setter Property="Foreground" Value="#CBA6F7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- 하단 삭제 제어 및 월간 현금/포인트 합산 바 -->
                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌측: 선택 항목 삭제 버튼 (왼쪽 정렬 고정) -->
                                <Button Grid.Column="0" Content="선택 항목 삭제" Command="{Binding DeleteHistoryExpenseCommand}" 
                                        CommandParameter="{Binding ElementName=DgHistoryExpenses, Path=SelectedItem}"
                                        Background="#F38BA8" Foreground="#11111B" Padding="14,6" FontSize="12"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                <!-- 우측: 월간 현금 및 포인트/머니 총 수입/지출 합산 요약 -->
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                        <TextBlock Text="월간 현금:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding MonthCashSpent, StringFormat='-{0:N0}원'}" Foreground="#FAB387" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding MonthCashIncome, StringFormat='+{0:N0}원'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                        <TextBlock Text="포인트/머니:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding MonthPointSpent, StringFormat='-{0:N0}원'}" Foreground="#89DCEB" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding MonthPointIncome, StringFormat='+{0:N0}원'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                        <TextBlock Text="이체:" Foreground="#BAC2DE" FontSize="11.5" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding MonthTransferTotal, StringFormat='{}{0:N0}원'}" Foreground="#CBA6F7" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                    <TextBlock Text="* 삭제 시 즉시 재계산 반영" Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
